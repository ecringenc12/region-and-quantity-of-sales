#include <stdio.h>
#include <stdlib.h>
int main() {
	int matris[2][3];
	int a,b;

	int toplam=0;
	for(a=0;a<=1;a++)
	{
		for(b=0;b<=2;b++)
		{
			printf("%d.bolgenin %d.grubunun aylik satis miktarini giriniz-> ",a+1,b+1);
			scanf("%d",&matris[a][b]);
			toplam=toplam+matris[a][b];
		}
		printf("\n");
		}
	printf("Toplam aylik satis miktari-> %d\n",toplam);
	int buyuk=matris[0][0];
	for(a=0;a<=1;a++)
	{
		for(b=0;b<=2;b++)
		{
			if(matris[a][b]>buyuk)
			{
				buyuk=matris[a][b];
			}
		}
		}
		printf("En cok satis miktari->%d",buyuk);

	
	return 0;
}
